{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["mode", "operation"],
  "properties": {
    "mode": {"type": "string", "enum": ["simple", "expert"]},
    "operation": {
      "type": "string",
      "enum": [
        "SIMPLE_GENERATE",
        "BREAKDOWN_SCRIPT",
        "SAVE_STORYBOARD",
        "GENERATE_ASSET_PRIMARY",
        "GENERATE_CHARACTER_THREE_VIEW",
        "GENERATE_VIDEO"
      ]
    },
    "prompt": {"type": "string", "minLength": 1, "maxLength": 4000},
    "script": {"type": "string", "minLength": 1, "maxLength": 20000},
    "storyboard": {"type": "array", "minItems": 1, "maxItems": 20},
    "assetType": {
      "type": "string",
      "enum": ["CHARACTER", "SCENE", "PROP", "UNCLASSIFIED"]
    },
    "assetName": {"type": "string", "minLength": 1, "maxLength": 120},
    "assetDescription": {"type": "string", "minLength": 1, "maxLength": 2000},
    "personality": {"type": "string", "maxLength": 1000},
    "durationSeconds": {
      "type": "integer",
      "enum": [3, 4, 5, 8, 10, 12, 15, 16, 18, 20],
      "default": 8
    },
    "aspectRatio": {
      "type": "string",
      "enum": ["16:9", "9:16"],
      "default": "16:9"
    },
    "resolution": {
      "type": "string",
      "enum": ["480p", "720p", "1080p"],
      "default": "720p"
    },
    "assetCatalog": {"type": "array", "maxItems": 100},
    "firstFrameAssetId": {
      "type": "string",
      "format": "uuid",
      "description": "可选首帧图片，必须是 inputAssetIds 中的第一张图片。"
    },
    "lastFrameAssetId": {
      "type": "string",
      "format": "uuid",
      "description": "可选尾帧图片；仅在所选视频模型支持至少两张图片时开放。"
    },
    "inputAssetIds": {
      "type": "array",
      "items": {"type": "string", "format": "uuid"},
      "maxItems": 20
    }
  },
  "additionalProperties": true
}
