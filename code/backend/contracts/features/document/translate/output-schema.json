{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["assetId", "name", "sourceAssetId"],
  "properties": {
    "assetId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "sourceAssetId": {
      "type": "string",
      "format": "uuid"
    }
  },
  "additionalProperties": false
}
