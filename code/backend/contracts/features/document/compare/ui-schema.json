      ],
      "allowedExtensions": [
        ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
        ".txt", ".md", ".csv", ".json"
      ],
      "maxItems": 5,
      "itemCountByFieldPresence": {
        "field": "baselineDocument",
        "present": {"minItems": 1, "maxItems": 4},
        "absent": {"minItems": 2, "maxItems": 5}
